# Local environment for `supabase functions serve generate-ideas`.
# Copy this file to .env.local (gitignored) and fill in the key.
#
# Production must use a Supabase Edge Function secret, not this file:
#   npx supabase secrets set GROQ_API_KEY=...
#
# Never add a VITE_ prefix and never commit the real key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# AI_PROVIDER_TIMEOUT_MS=20000
