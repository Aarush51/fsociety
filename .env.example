# Copy to .env and fill in with your Supabase project values.
# Both values are safe to expose in the browser: the publishable/anon key is
# protected by Row Level Security. Never put a service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Only needed by `npm run seed`, which runs on your machine (never in the
# browser). Put it in .env.local so Vite can never expose it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# ---- Roadmap AI (Node server only) ----
# Read by server/roadmap.mjs only. These are deliberately NOT prefixed with
# VITE_, so Vite never inlines them into the browser bundle. Never put an AI
# key in .env/.env.local with a VITE_ prefix.
#
# Any OpenAI-compatible provider works: set the base URL and model to match.
# AI_API_KEY=your-provider-key
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Optional: change the upstream timeout (milliseconds).
# AI_TIMEOUT_MS=30000

# ---- Idea generator (Supabase Edge Function: generate-ideas) ----
# GEMINI_API_KEY is NOT read by Vite or the Node server. Store it as a
# Supabase Edge Function secret instead:
#   npx supabase secrets set GEMINI_API_KEY=your-gemini-key
# For local Edge Function development, copy
# supabase/functions/.env.example to supabase/functions/.env.local.
# Never create a VITE_GEMINI_API_KEY or put the key in this file.
