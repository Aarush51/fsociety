# Copy to .env and fill in with your Supabase project values.
# Both values are safe to expose in the browser: the publishable/anon key is
# protected by Row Level Security. Never put a service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Only needed by `npm run seed`, which runs on your machine (never in the
# browser). Put it in .env.local so Vite can never expose it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
